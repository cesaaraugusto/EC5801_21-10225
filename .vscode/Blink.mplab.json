{
    "version": "1.9",
    "propertyGroups": [
        {
            "name": "default-XC8",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc8@3.10",
            "properties": {
                "compiler.isolate-each-function": true,
                "compiler.optimization-level": "-O1",
                "compiler.place-data-into-section": true,
                "linker.heap-size": "0",
                "linker.remove-unused-sections": true,
                "compiler++.isolate-each-function": true,
                "compiler++.optimization-level": "-O1"
            }
        }
    ],
    "fileSets": [
        {
            "name": "default",
            "files": [
                {
                    "include": "**/*",
                    "exclude": "**/(_build|out|cmake|.vscode)/**/*"
                },
                "My_MCC_Config/mcc_generated_files/system/src/clock.c",
                "My_MCC_Config/mcc_generated_files/system/src/interrupt.c",
                "My_MCC_Config/mcc_generated_files/timer/src/tmr0.c",
                "My_MCC_Config/mcc_generated_files/clb/src/clb1.c",
                "My_MCC_Config/mcc_generated_files/clb/src/clbBitstream.S",
                "My_MCC_Config/mcc_generated_files/system/src/system.c",
                "My_MCC_Config/mcc_generated_files/system/src/config_bits.c",
                "My_MCC_Config/main.c",
                "My_MCC_Config/mcc_generated_files/system/src/pins.c",
                "My_MCC_Config/mcc_generated_files/crc/src/crc.c"
            ]
        }
    ],
    "configurations": [
        {
            "name": "default",
            "id": "conf1",
            "device": "PIC16F13145",
            "imagePath": "./out/Blink/default.elf",
            "tool": "PKOB nano",
            "packs": [
                {
                    "name": "PIC16F1xxxx_DFP",
                    "vendor": "Microchip",
                    "version": "1.29.444"
                }
            ],
            "fileSet": "default",
            "toolchain": "default-XC8",
            "includeLegacyMacros": true
        }
    ]
}
